{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zemlyansky/archbird/raw/main/schema/file-facts.schema.json",
  "title": "Archbird compatibility file facts",
  "description": "Deterministic per-file evidence reduced from merged provider occurrences.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "project",
    "source_manifest_sha256",
    "files"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "artifact": {"const": "archbird-file-facts"},
    "project": {"$ref": "#/$defs/id"},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "files": {
      "type": "array",
      "items": {"$ref": "#/$defs/file"}
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000]+$"
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "countMap": {
      "type": "object",
      "additionalProperties": {"type": "integer", "minimum": 1}
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {"type": "string"}
    },
    "stringArrayMap": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/strings"}
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fact_id", "name", "kind", "scope", "line", "signature"],
      "properties": {
        "fact_id": {"type": "string", "pattern": "^f:[0-9a-f]{64}$"},
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "scope": {"type": "string"},
        "line": {"type": "integer", "minimum": 1},
        "signature": {"type": "string"},
        "documentation": {"$ref": "#/$defs/documentation"},
        "extent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": {"type": "integer", "minimum": 0},
            "end": {"type": "integer", "minimum": 1}
          }
        },
        "extent_lines": {"type": "integer", "minimum": 1},
        "span": {"$ref": "#/$defs/span"},
        "source_metrics": {"$ref": "#/$defs/sourceMetrics"},
        "syntax_recovery": {"const": "intersects"}
      }
    },
    "documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "text"],
      "properties": {
        "kind": {"enum": ["docstring", "doxygen", "jsdoc", "roxygen", "scip"]},
        "span": {"$ref": "#/$defs/span"},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "sourceMetricContributor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["construct", "contribution", "control_depth", "fact_id", "line", "nesting", "provider", "span"],
      "properties": {
        "construct": {"type": "string", "minLength": 1},
        "contribution": {"type": "integer", "minimum": 0},
        "control_depth": {"type": "integer", "minimum": 0},
        "fact_id": {"type": "string", "pattern": "^f:[0-9a-f]{64}$"},
        "line": {"type": "integer", "minimum": 1},
        "nesting": {"enum": [0, 1]},
        "provider": {"type": "string", "minLength": 1},
        "span": {"$ref": "#/$defs/span"},
        "syntax_recovery": {"const": "intersects"}
      }
    },
    "sourceMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contributors", "definition", "fact_id", "provider", "state", "values"],
      "properties": {
        "contributors": {
          "type": "array",
          "items": {"$ref": "#/$defs/sourceMetricContributor"}
        },
        "definition": {"type": "string", "pattern": "^source\\.control-flow\\.[A-Za-z0-9_-]+-v[0-9]+$"},
        "fact_id": {"type": "string", "pattern": "^f:[0-9a-f]{64}$"},
        "provider": {"type": "string", "minLength": 1},
        "state": {"enum": ["current", "unknown"]},
        "syntax_recovery": {"const": "intersects"},
        "values": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source.cyclomatic_complexity", "source.decision_count", "source.max_control_nesting"],
          "properties": {
            "source.cyclomatic_complexity": {"type": "integer", "minimum": 1},
            "source.decision_count": {"type": "integer", "minimum": 0},
            "source.max_control_nesting": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "sourceMetricAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current", "max", "unknown"],
      "properties": {
        "current": {"type": "integer", "minimum": 0},
        "definition": {"type": "string", "minLength": 1},
        "max": {"type": "integer", "minimum": 0},
        "max_fact_id": {"type": "string", "pattern": "^f:[0-9a-f]{64}$"},
        "max_symbol": {"type": "string", "minLength": 1},
        "unknown": {"type": "integer", "minimum": 0}
      }
    },
    "sourceMetricAggregates": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source.cyclomatic_complexity", "source.decision_count", "source.extent_lines", "source.max_control_nesting"],
      "properties": {
        "source.cyclomatic_complexity": {"$ref": "#/$defs/sourceMetricAggregate"},
        "source.decision_count": {"$ref": "#/$defs/sourceMetricAggregate"},
        "source.extent_lines": {"$ref": "#/$defs/sourceMetricAggregate"},
        "source.max_control_nesting": {"$ref": "#/$defs/sourceMetricAggregate"}
      }
    },
    "messages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sends", "receives"],
      "properties": {
        "sends": {"$ref": "#/$defs/strings"},
        "receives": {"$ref": "#/$defs/strings"}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "layer",
        "language",
        "bytes",
        "sha256",
        "symbols",
        "calls",
        "call_counts",
        "method_calls",
        "method_call_counts",
        "imports",
        "imported_names",
        "exports",
        "export_origins",
        "reexport_candidates",
        "messages",
        "metrics"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "layer": {"type": "string"},
        "language": {"type": "string"},
        "bytes": {"type": "integer", "minimum": 0},
        "documentation": {"$ref": "#/$defs/documentation"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "symbols": {
          "type": "array",
          "items": {"$ref": "#/$defs/symbol"}
        },
        "calls": {"$ref": "#/$defs/strings"},
        "call_counts": {"$ref": "#/$defs/countMap"},
        "method_calls": {"$ref": "#/$defs/strings"},
        "method_call_counts": {"$ref": "#/$defs/countMap"},
        "imports": {"$ref": "#/$defs/strings"},
        "imported_names": {"$ref": "#/$defs/stringArrayMap"},
        "exports": {"$ref": "#/$defs/strings"},
        "export_origins": {"$ref": "#/$defs/stringMap"},
        "reexport_candidates": {"$ref": "#/$defs/strings"},
        "messages": {"$ref": "#/$defs/messages"},
        "metrics": {"$ref": "#/$defs/sourceMetricAggregates"}
      }
    }
  }
}
