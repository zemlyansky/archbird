{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zemlyansky/archbird/raw/main/schema/act.schema.json",
  "title": "Archbird act",
  "description": "An exact binary-safe Act materialized from one Plan. Only an accepted Act has a verified after-state and content seal and may be applied.",
  "$comment": "Native and host validation additionally limit the canonical Act to 268435456 bytes, each file preimage or postimage to 67108864 bytes, aggregate postimage content to 268435456 bytes, and collections to 4096 entries. JSON Schema validates the public structural contract; native validation owns decoded byte lengths, digests, uniqueness by stable identity, and seal integrity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "provenance",
    "tool",
    "plan_sha256",
    "source",
    "state",
    "after",
    "gates",
    "executors",
    "source_locks",
    "transitions",
    "acceptance",
    "seal"
  ],
  "properties": {
    "schema_version": {"const": 5},
    "artifact": {"const": "act"},
    "provenance": {"const": "derived"},
    "tool": {"$ref": "#/$defs/tool"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "source": {"$ref": "#/$defs/source"},
    "state": {"enum": ["materialized", "accepted"]},
    "after": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/afterState"}
      ]
    },
    "gates": {"$ref": "#/$defs/gates"},
    "executors": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/executor"}
    },
    "source_locks": {
      "type": "array",
      "maxItems": 8192,
      "items": {"$ref": "#/$defs/sourceLock"}
    },
    "transitions": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/transition"}
    },
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "seal": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/seal"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "materialized"}}},
      "then": {
        "properties": {
          "after": {"type": "null"},
          "acceptance": {
            "properties": {
              "status": {"const": "not_evaluated"},
              "verification_sha256": {"type": "null"},
              "constraints": {
                "items": {
                  "properties": {"status": {"const": "not_evaluated"}}
                }
              },
              "gate_workspace_sha256": {"type": "null"},
              "gate_results": {"maxItems": 0}
            }
          },
          "seal": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "accepted"}}},
      "then": {
        "properties": {
          "after": {"$ref": "#/$defs/afterState"},
          "acceptance": {
            "properties": {
              "status": {"const": "satisfied"},
              "verification_sha256": {"$ref": "#/$defs/sha256"},
              "constraints": {
                "items": {
                  "properties": {
                    "status": {
                      "enum": ["pass", "waived", "not_applicable"]
                    }
                  }
                }
              },
              "gate_results": {
                "items": {
                  "properties": {
                    "status": {"const": "pass"},
                    "exit_code": {"const": 0}
                  }
                }
              }
            }
          },
          "seal": {"$ref": "#/$defs/seal"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000]+$"
    },
    "paths": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repositoryPath"}
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_sha256"],
      "properties": {
        "name": {"const": "archbird"},
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["argv", "timeout_seconds"],
      "properties": {
        "argv": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 4096}
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^(?:\\.|(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000]+)$"
        },
        "depends_on": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        },
        "timeout_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_output_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        }
      }
    },
    "gates": {
      "type": "object",
      "maxProperties": 4096,
      "propertyNames": {"$ref": "#/$defs/id"},
      "additionalProperties": {"$ref": "#/$defs/gate"}
    },
    "gateResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "definition_sha256",
        "status",
        "exit_code",
        "duration_ms",
        "environment_sha256",
        "stdout_sha256",
        "stderr_sha256",
        "stdout_tail_base64",
        "stderr_tail_base64"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "definition_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "pass"},
        "exit_code": {"const": 0},
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "environment_sha256": {"$ref": "#/$defs/sha256"},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_sha256": {"$ref": "#/$defs/sha256"},
        "stdout_tail_base64": {
          "type": "string",
          "maxLength": 87384,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        },
        "stderr_tail_base64": {
          "type": "string",
          "maxLength": 87384,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "mapIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "input_sha256",
        "configuration_sha256",
        "producer_implementation_sha256"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "producer_implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verificationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "policy_sha256",
        "producer_implementation_sha256"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "producer_implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "map", "verification"],
      "properties": {
        "before_map": {"$ref": "#/$defs/mapIdentity"},
        "project": {"type": "string", "minLength": 1, "maxLength": 65536},
        "map": {"$ref": "#/$defs/mapIdentity"},
        "verification": {"$ref": "#/$defs/verificationIdentity"}
      }
    },
    "afterState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map", "verification"],
      "properties": {
        "map": {"$ref": "#/$defs/mapIdentity"},
        "verification": {"$ref": "#/$defs/verificationIdentity"}
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "implementation_sha256",
        "deterministic",
        "item_ids",
        "matches",
        "skipped",
        "unsupported",
        "reads",
        "writes"
      ],
      "properties": {
        "capability": {"type": "string", "minLength": 1, "maxLength": 65536},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "deterministic": {"type": "boolean"},
        "item_ids": {"$ref": "#/$defs/ids"},
        "matches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reads": {"$ref": "#/$defs/paths"},
        "writes": {"$ref": "#/$defs/paths"}
      }
    },
    "beforeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_length", "executable"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "executable": {"type": "boolean"}
      }
    },
    "sourceLock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "executable"],
      "properties": {
        "path": {"$ref": "#/$defs/repositoryPath"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "executable": {"type": "boolean"}
      }
    },
    "afterFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_length", "executable", "content_base64"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "executable": {"type": "boolean"},
        "content_base64": {
          "type": "string",
          "maxLength": 89478488,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_ids",
        "kind",
        "path",
        "source_path",
        "before",
        "after"
      ],
      "properties": {
        "item_ids": {"$ref": "#/$defs/ids"},
        "kind": {"enum": ["create", "modify", "delete", "move"]},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "source_path": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/repositoryPath"}
          ]
        },
        "before": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/beforeFile"}
          ]
        },
        "after": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/afterFile"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "create"}}},
          "then": {
            "properties": {
              "source_path": {"type": "null"},
              "before": {"type": "null"},
              "after": {"$ref": "#/$defs/afterFile"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "modify"}}},
          "then": {
            "properties": {
              "source_path": {"type": "null"},
              "before": {"$ref": "#/$defs/beforeFile"},
              "after": {"$ref": "#/$defs/afterFile"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "delete"}}},
          "then": {
            "properties": {
              "source_path": {"type": "null"},
              "before": {"$ref": "#/$defs/beforeFile"},
              "after": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "move"}}},
          "then": {
            "properties": {
              "source_path": {"$ref": "#/$defs/repositoryPath"},
              "before": {"$ref": "#/$defs/beforeFile"},
              "after": {"$ref": "#/$defs/afterFile"}
            }
          }
        }
      ]
    },
    "constraintResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {
          "enum": [
            "not_evaluated",
            "pass",
            "waived",
            "not_applicable"
          ]
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verification_sha256",
        "constraints",
        "projection_deltas",
        "gate_workspace_sha256",
        "gate_results"
      ],
      "properties": {
        "status": {"enum": ["not_evaluated", "satisfied"]},
        "verification_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "constraints": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/constraintResult"}
        },
        "projection_deltas": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/projectionDelta"}
        },
        "gate_workspace_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "gate_results": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/gateResult"}
        }
      }
    },
    "edgeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["select"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "select": {"const": "file_edges"},
        "from_paths": {"$ref": "#/$defs/paths"},
        "to_paths": {"$ref": "#/$defs/paths"},
        "kinds": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 65536}
        },
        "kind_patterns": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 65536}
        },
        "name_patterns": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 65536}
        }
      }
    },
    "projectionKeys": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1, "maxLength": 65536}
    },
    "projectionDelta": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Native validation requires materialized rows to have null result identities and empty observed sets, accepted rows to have exact result identities and observed sets equal to the allowed sets, and every projection to be complete and exhaustive over both Maps.",
      "required": [
        "projection",
        "allowed_added",
        "allowed_removed",
        "status",
        "before_result_sha256",
        "after_result_sha256",
        "observed_added",
        "observed_removed"
      ],
      "properties": {
        "projection": {"$ref": "#/$defs/edgeProjection"},
        "allowed_added": {"$ref": "#/$defs/projectionKeys"},
        "allowed_removed": {"$ref": "#/$defs/projectionKeys"},
        "status": {"enum": ["not_evaluated", "satisfied"]},
        "before_result_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "after_result_sha256": {
          "oneOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]
        },
        "observed_added": {"$ref": "#/$defs/projectionKeys"},
        "observed_removed": {"$ref": "#/$defs/projectionKeys"}
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
