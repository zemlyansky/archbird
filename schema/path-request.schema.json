{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://archbird.org/schema/path-request.schema.json",
  "title": "Archbird Path Request",
  "type": "object",
  "required": ["artifact", "schema_version", "source", "target"],
  "properties": {
    "artifact": {"const": "path-request"},
    "schema_version": {"const": 1},
    "source": {"$ref": "#/$defs/endpoint"},
    "target": {"$ref": "#/$defs/endpoint"},
    "level": {"enum": ["component", "file", "symbol"]},
    "relations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "bridges",
          "builds",
          "calls",
          "declarations",
          "imports",
          "packages",
          "references",
          "tests"
        ]
      }
    },
    "direction": {"enum": ["downstream", "upstream", "both"]},
    "max_depth": {"type": "integer", "minimum": 0, "maximum": 64},
    "max_paths": {"type": "integer", "minimum": 1, "maximum": 100},
    "producer_policy": {"enum": ["compatible", "current"]}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {"level": {"const": "symbol"}},
        "required": ["level", "relations"]
      },
      "then": {
        "properties": {
          "relations": {
            "items": {"enum": ["calls", "references"]}
          }
        }
      }
    }
  ],
  "$defs": {
    "endpoint": {
      "type": "object",
      "required": ["kind", "patterns"],
      "properties": {
        "kind": {
          "anyOf": [
            {"const": "any"},
            {"type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"}
          ]
        },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    }
  }
}
