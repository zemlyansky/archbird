{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zemlyansky/archbird/raw/main/schema/visualization-event.schema.json",
  "title": "Archbird live-server event",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "payload", "protocol_version", "type"],
  "properties": {
    "event_id": {"type": "integer", "minimum": 0},
    "generation": {"$ref": "#/$defs/sha256"},
    "payload": {"type": "object"},
    "protocol_version": {"const": 2},
    "session": {"type": "string", "minLength": 1},
    "type": {
      "enum": [
        "scan-started",
        "progress",
        "candidate-failed",
        "snapshot-ready",
        "verification-ready",
        "display-updated"
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"type": {"const": "display-updated"}}},
      "then": {"properties": {"payload": {"$ref": "#/$defs/display"}}}
    }
  ],
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blob_sha256", "bytes", "generation", "project"],
      "properties": {
        "blob_sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "generation": {"$ref": "#/$defs/sha256"},
        "project": {"type": "string", "minLength": 1}
      }
    },
    "display": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact",
        "display",
        "generation",
        "method",
        "params",
        "revision"
      ],
      "properties": {
        "artifact": {"$ref": "#/$defs/artifact"},
        "display": {"type": "object"},
        "generation": {"$ref": "#/$defs/sha256"},
        "method": {"enum": ["map", "query", "path", "diff", "verify"]},
        "params": {"type": "object"},
        "presentation": {"$ref": "#/$defs/artifact"},
        "revision": {"type": "integer", "minimum": 1},
        "session": {"type": "string", "minLength": 1}
      }
    },
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
