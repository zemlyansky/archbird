{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zemlyansky/archbird/raw/main/schema/act.schema.json",
  "title": "Archbird act",
  "description": "An exact binary-safe Act materialized from one Plan. Only an accepted Act has a verified after-state and content seal and may be applied.",
  "$comment": "Native and host validation additionally limit the canonical Act to 268435456 bytes, each file preimage or postimage to 67108864 bytes, aggregate postimage content to 268435456 bytes, and collections to 4096 entries. JSON Schema validates the public structural contract; native validation owns decoded byte lengths, digests, uniqueness by stable identity, and seal integrity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "provenance",
    "tool",
    "plan_sha256",
    "source",
    "state",
    "after",
    "executors",
    "transitions",
    "acceptance",
    "seal"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "artifact": {"const": "act"},
    "provenance": {"const": "derived"},
    "tool": {"$ref": "#/$defs/tool"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "source": {"$ref": "#/$defs/source"},
    "state": {"enum": ["materialized", "accepted"]},
    "after": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/afterState"}
      ]
    },
    "executors": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/executor"}
    },
    "transitions": {
      "type": "array",
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/transition"}
    },
    "acceptance": {"$ref": "#/$defs/acceptance"},
    "seal": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/seal"}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"state": {"const": "materialized"}}},
      "then": {
        "properties": {
          "after": {"type": "null"},
          "acceptance": {
            "properties": {
              "status": {"const": "not_evaluated"},
              "verification_sha256": {"type": "null"},
              "constraints": {
                "items": {
                  "properties": {"status": {"const": "not_evaluated"}}
                }
              }
            }
          },
          "seal": {"type": "null"}
        }
      }
    },
    {
      "if": {"properties": {"state": {"const": "accepted"}}},
      "then": {
        "properties": {
          "after": {"$ref": "#/$defs/afterState"},
          "acceptance": {
            "properties": {
              "status": {"const": "satisfied"},
              "verification_sha256": {"$ref": "#/$defs/sha256"},
              "constraints": {
                "items": {
                  "properties": {
                    "status": {
                      "enum": ["pass", "waived", "not_applicable"]
                    }
                  }
                }
              }
            }
          },
          "seal": {"$ref": "#/$defs/seal"}
        }
      }
    }
  ],
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000]+$"
    },
    "paths": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repositoryPath"}
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_sha256"],
      "properties": {
        "name": {"const": "archbird"},
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "mapIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "input_sha256",
        "configuration_sha256",
        "producer_implementation_sha256"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "producer_implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verificationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "policy_sha256",
        "producer_implementation_sha256"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "producer_implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "map", "verification"],
      "properties": {
        "before_map": {"$ref": "#/$defs/mapIdentity"},
        "project": {"type": "string", "minLength": 1, "maxLength": 65536},
        "map": {"$ref": "#/$defs/mapIdentity"},
        "verification": {"$ref": "#/$defs/verificationIdentity"}
      }
    },
    "afterState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["map", "verification"],
      "properties": {
        "map": {"$ref": "#/$defs/mapIdentity"},
        "verification": {"$ref": "#/$defs/verificationIdentity"}
      }
    },
    "executor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "implementation_sha256",
        "deterministic",
        "item_ids",
        "matches",
        "skipped",
        "unsupported",
        "reads",
        "writes"
      ],
      "properties": {
        "capability": {"type": "string", "minLength": 1, "maxLength": 65536},
        "implementation_sha256": {"$ref": "#/$defs/sha256"},
        "deterministic": {"type": "boolean"},
        "item_ids": {"$ref": "#/$defs/ids"},
        "matches": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "skipped": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "unsupported": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "reads": {"$ref": "#/$defs/paths"},
        "writes": {"$ref": "#/$defs/paths"}
      }
    },
    "beforeFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_length", "executable"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "executable": {"type": "boolean"}
      }
    },
    "afterFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "byte_length", "executable", "content_base64"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108864
        },
        "executable": {"type": "boolean"},
        "content_base64": {
          "type": "string",
          "maxLength": 89478488,
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_ids",
        "kind",
        "path",
        "source_path",
        "before",
        "after"
      ],
      "properties": {
        "item_ids": {"$ref": "#/$defs/ids"},
        "kind": {"enum": ["create", "modify", "delete", "move"]},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "source_path": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/repositoryPath"}
          ]
        },
        "before": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/beforeFile"}
          ]
        },
        "after": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/afterFile"}
          ]
        }
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "create"}}},
          "then": {
            "properties": {
              "source_path": {"type": "null"},
              "before": {"type": "null"},
              "after": {"$ref": "#/$defs/afterFile"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "modify"}}},
          "then": {
            "properties": {
              "source_path": {"type": "null"},
              "before": {"$ref": "#/$defs/beforeFile"},
              "after": {"$ref": "#/$defs/afterFile"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "delete"}}},
          "then": {
            "properties": {
              "source_path": {"type": "null"},
              "before": {"$ref": "#/$defs/beforeFile"},
              "after": {"type": "null"}
            }
          }
        },
        {
          "if": {"properties": {"kind": {"const": "move"}}},
          "then": {
            "properties": {
              "source_path": {"$ref": "#/$defs/repositoryPath"},
              "before": {"$ref": "#/$defs/beforeFile"},
              "after": {"$ref": "#/$defs/afterFile"}
            }
          }
        }
      ]
    },
    "constraintResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "status": {
          "enum": [
            "not_evaluated",
            "pass",
            "waived",
            "not_applicable"
          ]
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "verification_sha256", "constraints"],
      "properties": {
        "status": {"enum": ["not_evaluated", "satisfied"]},
        "verification_sha256": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "constraints": {
          "type": "array",
          "maxItems": 4096,
          "items": {"$ref": "#/$defs/constraintResult"}
        }
      }
    },
    "seal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_sha256"],
      "properties": {
        "content_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
