{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zemlyansky/archbird/raw/main/schema/plan.schema.json",
  "title": "Archbird change plan",
  "description": "An editable plan derived from a source Map and Verification. The canonical digest is computed by Act when the plan is consumed and is intentionally not stored in this artifact.",
  "$comment": "Host validation additionally limits the canonical UTF-8 document to 67108864 bytes, every metadata string to 65536 UTF-8 bytes, every operation text field to 16777216 UTF-8 bytes, touched files to 4096, each existing or final source to 67108864 bytes, each of aggregate existing and final touched source to 268435456 bytes, and the aggregate rendered patch to 268435456 UTF-8 bytes. JSON Schema maxLength counts Unicode code points, so hosts enforce the corresponding byte limits.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "provenance",
    "tool",
    "source",
    "objective",
    "items",
    "preserved_constraints",
    "unknowns"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "artifact": {"const": "plan"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "tool": {"$ref": "#/$defs/tool"},
    "source": {"$ref": "#/$defs/source"},
    "objective": {"type": "string", "minLength": 1, "maxLength": 65536},
    "items": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "description": "Plan item IDs must additionally be unique under native or host validation.",
      "items": {"$ref": "#/$defs/item"}
    },
    "preserved_constraints": {"$ref": "#/$defs/ids"},
    "unknowns": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "description": "Unknown IDs must additionally be unique under native or host validation.",
      "items": {"$ref": "#/$defs/unknown"}
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "nullableId": {
      "oneOf": [
        {"type": "null"},
        {"$ref": "#/$defs/id"}
      ]
    },
    "ids": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "nonEmptyStrings": {
      "type": "array",
      "maxItems": 4096,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 65536
      }
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*//)(?!.*(?:^|/)\\.{1,2}(?:/|$))[^\\u0000]+$"
    },
    "optionalRepositoryPath": {
      "oneOf": [
        {"const": ""},
        {"$ref": "#/$defs/repositoryPath"}
      ]
    },
    "provenance": {
      "enum": ["derived", "asserted"]
    },
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "implementation_sha256"],
      "properties": {
        "name": {"const": "archbird"},
        "version": {"type": "string", "minLength": 1, "maxLength": 256},
        "implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "map", "verification"],
      "properties": {
        "before_map": {"$ref": "#/$defs/mapIdentity"},
        "project": {"type": "string", "minLength": 1, "maxLength": 65536},
        "map": {"$ref": "#/$defs/mapIdentity"},
        "verification": {"$ref": "#/$defs/verificationIdentity"}
      }
    },
    "mapIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "input_sha256",
        "configuration_sha256",
        "producer_implementation_sha256"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "input_sha256": {"$ref": "#/$defs/sha256"},
        "configuration_sha256": {"$ref": "#/$defs/sha256"},
        "producer_implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "verificationIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sha256",
        "policy_sha256",
        "producer_implementation_sha256"
      ],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "policy_sha256": {"$ref": "#/$defs/sha256"},
        "producer_implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "constraint_id",
        "constraint_result_sha256",
        "issue_fingerprint"
      ],
      "properties": {
        "constraint_id": {"$ref": "#/$defs/id"},
        "constraint_result_sha256": {"$ref": "#/$defs/sha256"},
        "issue_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provenance",
        "project",
        "path",
        "line",
        "sha256",
        "detail"
      ],
      "properties": {
        "provenance": {"enum": ["derived", "asserted", "observed"]},
        "project": {"type": "string", "maxLength": 65536},
        "path": {"$ref": "#/$defs/optionalRepositoryPath"},
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": {
          "oneOf": [
            {"const": ""},
            {"$ref": "#/$defs/sha256"}
          ]
        },
        "detail": {"type": "string", "maxLength": 65536}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["constraints"],
      "properties": {
        "constraints": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/id"}
        }
      }
    },
    "unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "item_id", "constraint_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "item_id": {"$ref": "#/$defs/nullableId"},
        "constraint_id": {"$ref": "#/$defs/nullableId"}
      }
    },
    "replaceRange": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Native or host validation must additionally enforce start_byte <= end_byte and that before equals the source bytes in the locked range.",
      "required": [
        "action",
        "path",
        "source_sha256",
        "start_byte",
        "end_byte",
        "before",
        "replacement"
      ],
      "properties": {
        "action": {"const": "replace_range"},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "before": {"type": "string", "maxLength": 16777216},
        "replacement": {"type": "string", "maxLength": 16777216}
      }
    },
    "createFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "path", "content"],
      "properties": {
        "action": {"const": "create_file"},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "content": {"type": "string", "maxLength": 16777216}
      }
    },
    "deleteFile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "path", "source_sha256"],
      "properties": {
        "action": {"const": "delete_file"},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "moveFile": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Native or host validation must additionally enforce distinct source and destination paths.",
      "required": [
        "action",
        "source_path",
        "destination_path",
        "source_sha256"
      ],
      "properties": {
        "action": {"const": "move_file"},
        "source_path": {"$ref": "#/$defs/repositoryPath"},
        "destination_path": {"$ref": "#/$defs/repositoryPath"},
        "source_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "jsonPointerEdit": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Act resolves the RFC 6901 pointer exactly against the source-locked JSON document. Replacement compares expected by canonical JSON value; insertion requires expected_absent and an existing object parent.",
      "required": [
        "action",
        "path",
        "source_sha256",
        "pointer",
        "expected_absent",
        "replacement"
      ],
      "properties": {
        "action": {"const": "edit_json_pointer"},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "pointer": {
          "type": "string",
          "maxLength": 65536
        },
        "expected_absent": {"type": "boolean"},
        "expected": {},
        "replacement": {}
      },
      "allOf": [
        {
          "if": {
            "properties": {"expected_absent": {"const": true}},
            "required": ["expected_absent"]
          },
          "then": {"not": {"required": ["expected"]}},
          "else": {"required": ["expected"]}
        }
      ]
    },
    "providerIdentity": {
      "$comment": "Configuration-derived provider identity. Language-specific token spelling, source anchors, byte ranges, and replacement text are grounded by Act.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition_sha256", "kind", "path", "variable"],
          "properties": {
            "definition_sha256": {"$ref": "#/$defs/sha256"},
            "kind": {"const": "make_variable"},
            "path": {"$ref": "#/$defs/repositoryPath"},
            "variable": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "maxLength": 256
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition_sha256", "kind", "path"],
          "properties": {
            "definition_sha256": {"$ref": "#/$defs/sha256"},
            "kind": {"const": "file_pattern"},
            "path": {"$ref": "#/$defs/repositoryPath"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["definition_sha256", "kind", "path"],
          "properties": {
            "definition_sha256": {"$ref": "#/$defs/sha256"},
            "kind": {"const": "exports"},
            "path": {"$ref": "#/$defs/repositoryPath"}
          }
        }
      ]
    },
    "providerCapability": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Language-neutral provider-surface objective. Act selects the configured provider executor and grounds exact source edits.",
      "required": ["action", "capability", "provider", "surface"],
      "properties": {
        "action": {
          "enum": [
            "add_provider_capability",
            "remove_provider_capability"
          ]
        },
        "capability": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 256
        },
        "provider": {"$ref": "#/$defs/providerIdentity"},
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryPath"}
        },
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "properties": {"kind": {"const": "file_pattern"}},
                "required": ["kind"]
              }
            },
            "required": ["provider"]
          },
          "then": {
            "required": ["source_paths"],
            "properties": {
              "action": {"const": "add_provider_capability"},
              "source_paths": {"minItems": 2, "maxItems": 2}
            }
          },
          "else": {
            "if": {
              "properties": {
                "provider": {
                  "properties": {"kind": {"const": "exports"}},
                  "required": ["kind"]
                }
              },
              "required": ["provider"]
            },
            "then": {
              "required": ["source_paths"],
              "properties": {
                "action": {"const": "add_provider_capability"},
                "source_paths": {"minItems": 1, "maxItems": 1}
              }
            },
            "else": {"not": {"required": ["source_paths"]}}
          }
        }
      ]
    },
    "setPackageEntrypoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "package", "path", "route", "target"],
      "properties": {
        "action": {"const": "set_package_entrypoint"},
        "package": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "path": {"$ref": "#/$defs/repositoryPath"},
        "route": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "target": {"$ref": "#/$defs/repositoryPath"}
      }
    },
    "providerCapabilityRename": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Language-neutral provider-surface rename objective. Act proves the old and replacement capabilities against the current Map before grounding.",
      "required": ["action", "from", "provider", "surface", "to"],
      "properties": {
        "action": {"const": "rename_provider_capability"},
        "from": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 256
        },
        "provider": {"$ref": "#/$defs/providerIdentity"},
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "to": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "properties": {
            "provider": {
              "properties": {"kind": {"const": "make_variable"}},
              "required": ["kind"]
            }
          }
        }
      ]
    },
    "declareSymbol": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "Language-neutral declaration objective. Act selects an executor from the mapped destination language and grounds exact syntax and placement.",
      "required": [
        "action",
        "path",
        "symbol",
        "source_paths"
      ],
      "properties": {
        "action": {"const": "declare_symbol"},
        "path": {"$ref": "#/$defs/repositoryPath"},
        "symbol": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 256
        },
        "source_paths": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryPath"}
        }
      }
    },
    "symbolOccurrenceProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["select", "names"],
      "properties": {
        "select": {"const": "symbol_occurrences"},
        "names": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          }
        },
        "paths": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryPath"}
        }
      }
    },
    "renameSymbol": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "A language-independent reviewed rename objective. Act re-evaluates the exhaustive occurrence projection and grounds exact source edits through a language executor.",
      "required": [
        "action",
        "symbol",
        "new_name",
        "projection",
        "projection_id",
        "projection_content_sha256",
        "source_paths"
      ],
      "properties": {
        "action": {"const": "rename_symbol"},
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "new_name": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
          "maxLength": 256
        },
        "projection": {"$ref": "#/$defs/symbolOccurrenceProjection"},
        "projection_id": {"$ref": "#/$defs/id"},
        "projection_content_sha256": {"$ref": "#/$defs/sha256"},
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryPath"}
        }
      }
    },
    "edgeProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["select"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "select": {"enum": ["component_edges", "file_edges"]},
        "from_paths": {"$ref": "#/$defs/nonEmptyStrings"},
        "to_paths": {"$ref": "#/$defs/nonEmptyStrings"},
        "kinds": {"$ref": "#/$defs/nonEmptyStrings"},
        "kind_patterns": {"$ref": "#/$defs/nonEmptyStrings"},
        "name_patterns": {"$ref": "#/$defs/nonEmptyStrings"}
      }
    },
    "redirectDependency": {
      "type": "object",
      "additionalProperties": false,
      "$comment": "A language-independent reviewed dependency redirect. Act re-evaluates the exhaustive edge projection and grounds exact source edits through a language executor.",
      "required": [
        "action",
        "from_symbol",
        "to_symbol",
        "projection",
        "projection_id",
        "projection_content_sha256",
        "relation",
        "source_paths"
      ],
      "properties": {
        "action": {"const": "redirect_dependency"},
        "from_symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "to_symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "projection": {"$ref": "#/$defs/edgeProjection"},
        "projection_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "projection_content_sha256": {"$ref": "#/$defs/sha256"},
        "relation": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "source_paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryPath"}
        }
      }
    },
    "manual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "instructions", "candidate_paths"],
      "properties": {
        "action": {"const": "manual"},
        "instructions": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "candidate_paths": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/repositoryPath"}
        },
        "candidate_sites": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/candidateSite"}
        }
      }
    },
    "candidateSite": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fact_id",
        "path",
        "line",
        "source_sha256",
        "start_byte",
        "end_byte",
        "before",
        "name"
      ],
      "properties": {
        "fact_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "path": {"$ref": "#/$defs/repositoryPath"},
        "line": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "start_byte": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "end_byte": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "before": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        }
      }
    },
    "operation": {
      "oneOf": [
        {"$ref": "#/$defs/replaceRange"},
        {"$ref": "#/$defs/createFile"},
        {"$ref": "#/$defs/deleteFile"},
        {"$ref": "#/$defs/moveFile"},
        {"$ref": "#/$defs/jsonPointerEdit"},
        {"$ref": "#/$defs/setPackageEntrypoint"},
        {"$ref": "#/$defs/providerCapability"},
        {"$ref": "#/$defs/providerCapabilityRename"},
        {"$ref": "#/$defs/declareSymbol"},
        {"$ref": "#/$defs/renameSymbol"},
        {"$ref": "#/$defs/redirectDependency"},
        {"$ref": "#/$defs/manual"}
      ]
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "statement",
        "provenance",
        "origins",
        "evidence",
        "depends_on",
        "operation",
        "acceptance",
        "unknowns",
        "executable",
        "non_executable_reasons"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 65536
        },
        "provenance": {"$ref": "#/$defs/provenance"},
        "origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/origin"}
        },
        "evidence": {
          "type": "array",
          "maxItems": 4096,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/evidence"}
        },
        "depends_on": {"$ref": "#/$defs/ids"},
        "operation": {"$ref": "#/$defs/operation"},
        "acceptance": {"$ref": "#/$defs/acceptance"},
        "unknowns": {"$ref": "#/$defs/ids"},
        "executable": {"type": "boolean"},
        "non_executable_reasons": {"$ref": "#/$defs/nonEmptyStrings"}
      },
      "allOf": [
        {
          "if": {
            "properties": {"executable": {"const": true}},
            "required": ["executable"]
          },
          "then": {
            "properties": {
              "non_executable_reasons": {"maxItems": 0},
              "operation": {
                "not": {
                  "properties": {"action": {"const": "manual"}},
                  "required": ["action"]
                }
              }
            }
          },
          "else": {
            "properties": {
              "non_executable_reasons": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "operation": {
                "properties": {"action": {"const": "manual"}},
                "required": ["action"]
              }
            },
            "required": ["operation"]
          },
          "then": {
            "properties": {
              "executable": {"const": false},
              "non_executable_reasons": {"minItems": 1}
            }
          }
        },
        {
          "if": {
            "properties": {
              "executable": {"const": true},
              "operation": {
                "properties": {
                  "action": {
                    "enum": ["redirect_dependency", "rename_symbol"]
                  }
                },
                "required": ["action"]
              }
            },
            "required": ["executable", "operation"]
          },
