{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zemlyansky/archbird/raw/main/schema/evaluation-run.schema.json",
  "title": "Archbird historical-change evaluation run",
  "description": "Immutable observed metrics, cache policy, and performance environment from one Archbird executable over one frozen evaluation corpus.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact",
    "provenance",
    "corpus_sha256",
    "label",
    "evaluator",
    "cache_policy",
    "host",
    "tool",
    "cases",
    "aggregate"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "artifact": {"const": "archbird-evaluation-run"},
    "provenance": {"const": "observed"},
    "corpus_sha256": {"$ref": "#/$defs/sha256"},
    "cache_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider_cache"],
      "properties": {
        "provider_cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initial_state", "max_bytes", "mode", "reuse"],
          "properties": {
            "initial_state": {"const": "empty"},
            "max_bytes": {"type": "integer", "minimum": 1},
            "mode": {"const": "isolated_per_case"},
            "reuse": {"const": "before_and_after_revision"}
          }
        }
      }
    },
    "held_out_opened": {"type": "boolean"},
    "label": {"type": "string", "minLength": 1},
    "evaluator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["implementation_sha256"],
      "properties": {
        "implementation_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "available_cpus",
        "logical_cpus",
        "machine",
        "node_sha256",
        "platform",
        "processor",
        "runtime"
      ],
      "properties": {
        "available_cpus": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "logical_cpus": {
          "oneOf": [
            {"type": "integer", "minimum": 1},
            {"type": "null"}
          ]
        },
        "machine": {"type": "string"},
        "node_sha256": {"$ref": "#/$defs/sha256"},
        "platform": {"type": "string"},
        "processor": {"type": "string"},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["implementation", "version"],
          "properties": {
            "implementation": {"type": "string", "minLength": 1},
            "version": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "tool": {"type": "object"},
    "cases": {"type": "array", "items": {"type": "object"}},
    "aggregate": {"type": "object"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
